# Copy to .env. Inside Docker Compose, DATABASE_URL and REDIS_URL are overridden to point at the
# compose services; the values below are for running the API or tests directly on your machine.
ENVIRONMENT=local
LOG_LEVEL=INFO

POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
POSTGRES_DB=assistant
# Host ports (5432/6379 are often taken by other local projects).
POSTGRES_PORT=5434
REDIS_PORT=6380
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://assistant:assistant@localhost:5434/assistant

REDIS_URL=redis://localhost:6380/0
EMBEDDING_CACHE_TTL_SECONDS=604800

# Changing to a model with a different dimension needs a new migration (see alembic/versions/0001).
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu

CHUNK_SIZE=800
CHUNK_OVERLAP=120
SEARCH_CANDIDATES=40
RRF_K=60
SEARCH_TOP_K=5

DEFAULT_TENANT=demo-bank
MAX_UPLOAD_MB=20

# --- Phase 2: agent, memory, voice ---
# /chat, /chat/stream and /voice/chat need ONE provider configured.
# claude | gemini | openai (any OpenAI-compatible API, e.g. Azure OpenAI)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Azure OpenAI: base URL is https://<resource>.openai.azure.com/openai/v1/ and the model is your
# *deployment* name. Plain OpenAI: leave OPENAI_BASE_URL empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
LLM_EFFORT=low
LLM_MAX_TOKENS=8000
AGENT_MAX_TOOL_ROUNDS=6
MEMORY_MAX_MESSAGES=20
MEMORY_TTL_SECONDS=86400
REDEMPTION_CONFIRM_TTL_SECONDS=600
VOICE_ENABLED=true
WHISPER_MODEL=small
MAX_AUDIO_MB=10

# --- Phase 3: auth, rate limits, resilience, semantic cache, jobs ---
# Required, 32+ characters. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_SECONDS=3600
RATE_LIMIT_USER_PER_MINUTE=30
RATE_LIMIT_USER_BURST=10
RATE_LIMIT_TENANT_PER_MINUTE=600
RATE_LIMIT_TENANT_BURST=100
# Optional second provider/model, used when the primary fails or its circuit is open.
# A different Gemini model has its own free-tier quota; or claude + claude-sonnet-5-5.
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_FIRST_EVENT_TIMEOUT_SECONDS=25
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_SECONDS=30
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.965
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_URL=amqp://guest:guest@localhost:5673/
JOB_MAX_ATTEMPTS=3
