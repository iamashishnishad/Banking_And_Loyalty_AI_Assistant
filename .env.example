# Copy to .env. Inside Docker Compose, DATABASE_URL and REDIS_URL are overridden to point at the
# compose services; the values below are for running the API or tests directly on your machine.
ENVIRONMENT=local
LOG_LEVEL=INFO

POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
POSTGRES_DB=assistant
# Host ports (5432/6379 are often taken by other local projects).
POSTGRES_PORT=5434
REDIS_PORT=6380
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://assistant:assistant@localhost:5434/assistant

REDIS_URL=redis://localhost:6380/0
EMBEDDING_CACHE_TTL_SECONDS=604800

# Changing to a model with a different dimension needs a new migration (see alembic/versions/0001).
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu

CHUNK_SIZE=800
CHUNK_OVERLAP=120
SEARCH_CANDIDATES=40
RRF_K=60
SEARCH_TOP_K=5

DEFAULT_TENANT=demo-bank
MAX_UPLOAD_MB=20
